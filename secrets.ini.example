# Alle echten Zugangsdaten/Passwoerter/Tokens stehen HIER, nicht in config.py.
#
# Normalerweise brauchst du diese Datei gar nicht von Hand anzulegen: starte
# 'python webapp\app.py' und ruf im Browser http://localhost:5000/setup auf -
# der Setup-Assistent schreibt secrets.ini automatisch fuer dich.
#
# Falls du es doch lieber von Hand machen willst: diese Datei nach
# 'secrets.ini' kopieren und die Werte eintragen.
#
# Format: KEY=WERT (kein Leerzeichen um das =, keine Anfuehrungszeichen noetig)
# Zeilen mit # am Anfang sind Kommentare und werden ignoriert.

DISCORD_BOT_TOKEN=
AMP_USER=
AMP_PASSWORD=
WEBAPP_SECRET_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ADMIN_PASSWORD=
TOPGAMES_TOKEN=
